{
  "competency": {
    "id": "acme.passthrough.bridge",
    "title": "Passthrough MCP Bridge",
    "description": "1:1 proxy of all upstream tools with no virtual mappings.",
    "version": "1.0.0",
    "docker_image": "yourregistry.azurecr.io/dorg-mcp-bridge:1.0.0",
    "supported_dorg_versions": ["3.*"],
    "intended_usage": ["Use for full upstream tool surface with no renaming."],
    "env": [
      {
        "key": "UPSTREAM_MCP_ENDPOINT",
        "label": "Remote MCP endpoint",
        "required": true,
        "secret": false
      },
      {
        "key": "UPSTREAM_API_KEY",
        "label": "Remote MCP API key",
        "required": false,
        "secret": true
      }
    ]
  },
  "upstream": {
    "endpoint": "https://example.com/mcp"
  },
  "manifest_output": "competency.manifest.json",
  "tool_defaults": {
    "allowed_groups": ["all_users"],
    "injected_params": [{ "key": "user_email" }]
  },
  "tool_mappings": {
    "passthrough_unmapped": true,
    "exclude_upstream": [],
    "mappings": []
  }
}
