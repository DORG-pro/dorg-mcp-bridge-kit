# Dorg MCP bridge — runtime configuration.
# Copy to `.env` for local development. NEVER commit real secrets.

UPSTREAM_MCP_ENDPOINT=https://example.com/mcp
UPSTREAM_API_KEY=
UPSTREAM_BEARER_TOKEN=
UPSTREAM_AUTH_MODE=api_key
UPSTREAM_AUTH_HEADER=X-Api-Key

# OAuth 2.0 refresh-token grant (UPSTREAM_AUTH_MODE=oauth).
# Mint the refresh token once with: python -m cli oauth-bootstrap
UPSTREAM_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
UPSTREAM_OAUTH_CLIENT_ID=
UPSTREAM_OAUTH_CLIENT_SECRET=
UPSTREAM_OAUTH_REFRESH_TOKEN=
UPSTREAM_OAUTH_SCOPES=
UPSTREAM_OAUTH_TIMEOUT_SECONDS=30

BRIDGE_AUTH_TOKEN=
MANIFEST_PATH=competency.manifest.json
HANDLERS_MODULE=competency_handlers
DOCUMENTATION_PATH=DOCUMENTATION.md
ICON_PATH=icon.png

UPSTREAM_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
PORT=8080
BRIDGE_SERVER_NAME=dorg-mcp-bridge
BRIDGE_SERVER_VERSION=1.0.0
