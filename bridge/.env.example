# Dorg MCP bridge — runtime configuration.
# Copy to `.env` for local development. NEVER commit real secrets.

UPSTREAM_MCP_ENDPOINT=https://example.com/mcp
UPSTREAM_API_KEY=
UPSTREAM_BEARER_TOKEN=
UPSTREAM_AUTH_MODE=api_key
UPSTREAM_AUTH_HEADER=X-Api-Key

BRIDGE_AUTH_TOKEN=
MANIFEST_PATH=competency.manifest.json
HANDLERS_MODULE=competency_handlers
DOCUMENTATION_PATH=DOCUMENTATION.md

UPSTREAM_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
PORT=8080
BRIDGE_SERVER_NAME=dorg-mcp-bridge
BRIDGE_SERVER_VERSION=1.0.0
